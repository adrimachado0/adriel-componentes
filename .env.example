# Supabase (Project Settings → API). Only the public anon key: the service_role key is never used.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL (no trailing slash). Used for metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact
# WhatsApp in international format without "+", e.g. 5491122334455
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
